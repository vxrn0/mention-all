"""Mention All — exteraGram / exteraless / AyuGram plugin.

Replaces @all in outgoing group messages with mentions of every group member
(using text-mention entities for members without a username) while keeping
the local frontend message displayed as @all for the sender.

Permissions:
- messages.send: outgoing-message hook and resend after member fetch.
- network: TL request for group participants.
- hooks: @all mention autocomplete (MentionsAdapter) and local frontend
  display masking (MessageObject).
"""

__id__ = "mention_all"
__name__ = "Mention All"
__description__ = "Type @all in a group to mention every member."
__author__ = "@vxrn0"
__version__ = "1.4.1"
__icon__ = "exteraPlugins/1"
__category__ = "chats"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.3"
__permissions__ = ["messages.send", "network", "hooks"]

import hashlib
import json
import re
import threading
import time
import unicodedata
from typing import Any, List, Optional, Tuple

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Input, Switch, Text

# Standalone @all token, never matching inside @username or @@all.
TOKEN_RE = re.compile(r"(?<![\w@])@all(?!\w)", re.IGNORECASE)
# Removes duplicate tokens along with one preceding space to avoid gaps.
TOKEN_CLEAN = re.compile(r"\s?(?<![\w@])@all(?!\w)", re.IGNORECASE)

SUPERGROUP_FLAG = -1000000000000

_FAIL_TTL = 60.0       # seconds to bypass re-trying the same failed text
_MEMBERS_TTL = 600.0   # seconds to cache group members per (account, peer)
_ALL_USER_ID = -5      # synthetic TL_user id for the @all autocomplete row
_MASK_LIMIT = 200      # max persisted (chat_id, expanded_text) -> @all entries
_MASK_KEY = "_masked_map"


def is_invisible(ch: str) -> bool:
    """Return True for invisible format/control/variation-selector characters.

    Telegram allows profile names made solely of such characters (e.g. U+FE0E),
    which render as empty text under a mentionName entity.
    """
    if "\ufe00" <= ch <= "\ufe0f" or "\U000e0100" <= ch <= "\U000e01ef":
        return True
    return unicodedata.category(ch) in ("Cf", "Cc", "Cs", "Co")


def clean_label(name: str) -> str:
    """Strip invisible characters and collapse whitespace, keeping combining marks."""
    kept = []
    for ch in name or "":
        if is_invisible(ch):
            continue
        kept.append(" " if ch.isspace() else ch)
    return " ".join("".join(kept).split())


def utf16len(s: str) -> int:
    # Telegram entity offsets and lengths use UTF-16 code units.
    return len(s.encode("utf-16-le")) // 2


def chat_id_from_dialog(dialog_id: int) -> Optional[int]:
    """Convert dialog_id to a positive chat/channel id, or None for DMs."""
    if SUPERGROUP_FLAG < dialog_id < 0:
        return -dialog_id
    if dialog_id <= SUPERGROUP_FLAG:
        return -dialog_id + SUPERGROUP_FLAG
    return None


def mask_key(chat_id: int, expanded_text: str) -> str:
    """Compact deterministic key mapping a sent expanded message back to @all."""
    raw = "%d\0%s" % (int(chat_id), expanded_text)
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:24]


def build_mentions(text: str, members: List[Tuple[int, Optional[str], str]],
                   limit: int, unnamed_label: str = "Unnamed"
                   ) -> Tuple[str, List[Tuple[int, int, int, Optional[str]]]]:
    """Replace the first @all with member mentions and strip duplicate tokens.

    members: [(user_id, username|None, display_name)]. Members with a username
    use @username; others use their display name with a text-mention entity.
    Returns (new_text, [(offset_utf16, length_utf16, user_id, username|None)]).
    """
    match = TOKEN_RE.search(text)
    if match is None or not members:
        return text, []
    # Strip @all from display names so the resend hook cannot loop.
    picked = [(uid, (uname or "").strip(), TOKEN_CLEAN.sub("", name))
              for uid, uname, name in members[:max(0, limit)]]
    pieces = []
    spans = []
    pos = utf16len(text[:match.start()])
    for uid, uname, raw_name in picked:
        if uname:
            span = "@" + uname
        else:
            name = clean_label(raw_name)
            # Keep literal whitespace names; only invisible/empty names get an ID label.
            span = name or (raw_name if raw_name and raw_name.isspace()
                            else "%s · %d" % (unnamed_label, uid))
        pieces.append(span)
        spans.append((pos, utf16len(span), uid, uname or None))
        pos += utf16len(span) + 1
    new_text = text[:match.start()] + " ".join(pieces) \
        + TOKEN_CLEAN.sub("", text[match.end():])
    return new_text, spans


def pick_members(entries: List[Tuple[int, str, str, bool]], me: int):
    """Select who to mention: live humans first, then bots/deleted, else all.

    entries: [(user_id, username, name, is_bot_or_deleted)]. The final fallback
    guards against mismatched self-ID comparisons eating the whole list.
    """
    people = [e for e in entries if e[0] != me and not e[3]]
    others = [e for e in entries if e[0] != me and e[3]]
    chosen = people or others
    if chosen:
        return [(uid, uname, name) for uid, uname, name, _ in chosen], False
    return [(uid, uname, name) for uid, uname, name, _ in entries], True


def fallback_text(text: str) -> str:
    """Text to send after a failure: without @all, but never blank."""
    stripped = TOKEN_CLEAN.sub("", text).strip()
    return stripped or text


def _error_text(error) -> str:
    if error is None:
        return ""
    return str(getattr(error, "text", None) or error)


def _jlist(java_list) -> list:
    """Convert a Java List proxy to a Python list via indexed access."""
    out = []
    if java_list is None:
        return out
    for i in range(java_list.size()):
        out.append(java_list.get(i))
    return out


def is_all_suggestion_prefix(text: str) -> bool:
    """Return True when the active @-mention token before cursor matches @all."""
    at = text.rfind("@")
    if at < 0 or (at > 0 and text[at - 1] not in " \n"):
        return False
    return "all".startswith(text[at + 1:].lower())


class MentionAllPlugin(BasePlugin):
    # Class-level state survives in-process plugin reloads.
    _recent_fail = {}
    _members = {}
    _masked = {}
    _masked_loaded = False

    def on_plugin_load(self):
        self._local = threading.local()
        self.add_on_send_message_hook()
        self._ensure_masked_loaded()
        self._register_hook_group("mention autocomplete", "org.telegram.ui.Adapters.MentionsAdapter", (
            ("searchUsernameOrHashtag", self._before_mention_search, None),
            ("showUsersResult", self._before_show_users_result, None),
        ))
        self._register_hook_group("message masking", "org.telegram.messenger.MessageObject", (
            ("setType", None, self._after_message_set_type),
            ("generateLayout", self._before_message_layout, self._after_message_layout),
            ("generateCaption", self._before_message_caption, self._after_message_caption),
        ))
        self._register_hook_group("dialog preview masking", "org.telegram.ui.Cells.DialogCell", (
            ("getMessageStringFormatted", self._before_dialog_preview, self._after_dialog_preview),
        ))
        self.log("mention-all loaded")

    def _register_hook_group(self, label: str, class_name: str, hooks):
        installed = []
        try:
            for method, before, after in hooks:
                hook = self.hook_method((class_name, method), before=before, after=after)
                if hook is None:
                    raise RuntimeError("could not hook " + method)
                installed.append(hook)
        except Exception as exc:
            for hook in installed:
                try:
                    self.unhook_method(hook)
                except Exception:
                    pass
            self.log("%s unavailable: %s" % (label, exc))

    # ---- localization (English default, Russian when client language is ru) ----

    def _app_language(self) -> str:
        try:
            from org.telegram.messenger import LocaleController
            code = str(LocaleController.getLocaleStringIso639() or "en").lower()
        except Exception:
            code = "en"
        return "ru" if code.split("-")[0].split("_")[0] == "ru" else "en"

    def _text(self, english: str, russian: str) -> str:
        return russian if self._app_language() == "ru" else english

    # ---- @all mention autocomplete ----

    def _is_group_chat(self, chat) -> bool:
        if chat is None:
            return False
        try:
            from org.telegram.messenger import ChatObject
            return not bool(ChatObject.isChannelAndNotMegaGroup(chat))
        except Exception:
            return not (bool(getattr(chat, "broadcast", False))
                        and not bool(getattr(chat, "megagroup", False)))

    def _set_all_suggestion(self, adapter, enabled: bool):
        try:
            states = self.__dict__.get("_all_suggestion_adapters")
            if states is None:
                from java.util import WeakHashMap
                states = WeakHashMap()
                self.__dict__["_all_suggestion_adapters"] = states
            states.put(adapter, bool(enabled))
        except Exception as exc:
            self.log("mention autocomplete state failed: %s" % exc)

    def _has_all_suggestion(self, adapter) -> bool:
        states = self.__dict__.get("_all_suggestion_adapters")
        if states is None:
            return False
        try:
            if not bool(states.get(adapter)):
                return False
            return (adapter.getFoundContextBot() is None
                    and not adapter.isBotContext()
                    and not adapter.isStickers()
                    and not adapter.isBotCommands())
        except Exception:
            return False

    def _all_suggestion_user(self):
        """Synthetic TL_user so MentionCell and ChatActivity handle @all natively."""
        from org.telegram.tgnet import TLRPC

        user = TLRPC.TL_user()
        user.id = _ALL_USER_ID
        user.username = "all"
        user.first_name = self._text("Mention everyone", "Упомянуть всех")
        user.bot = False
        user.self = False
        return user

    def _before_mention_search(self, param):
        adapter = param.thisObject
        enabled = False
        try:
            args = param.args
            text = args[0]
            if (self.get_setting("enabled", True) and text is not None
                    and not bool(args[3]) and not bool(args[4])):
                cursor = int(args[1])
                length = int(text.length()) if hasattr(text, "length") else len(text)
                end = max(0, min(cursor, length))
                try:
                    prefix = str(text.subSequence(0, end))
                except Exception:
                    prefix = str(text)[:end]
                fragment = getattr(adapter, "parentFragment", None)
                chat = fragment.getCurrentChat() if fragment is not None else None
                if chat is None:
                    chat = getattr(adapter, "chat", None)
                enabled = (self._is_group_chat(chat)
                           and is_all_suggestion_prefix(prefix))
        except Exception as exc:
            self.log("mention autocomplete search failed: %s" % exc)
        self._set_all_suggestion(adapter, enabled)

    def _before_show_users_result(self, param):
        if not self._has_all_suggestion(param.thisObject):
            return
        try:
            results = param.args[0]
            if results is None:
                return
            if results.size() == 0 or int(getattr(results.get(0), "id", 0)) != _ALL_USER_ID:
                results.add(0, self._all_suggestion_user())
        except Exception as exc:
            self.log("mention autocomplete result failed: %s" % exc)

    # ---- frontend masking (show @all locally while sending full mentions) ----

    def _ensure_masked_loaded(self) -> bool:
        if MentionAllPlugin._masked_loaded:
            return bool(MentionAllPlugin._masked)
        MentionAllPlugin._masked_loaded = True
        try:
            raw = self.get_setting(_MASK_KEY, "")
            if isinstance(raw, str) and raw:
                data = json.loads(raw)
                if isinstance(data, dict):
                    for k, v in data.items():
                        if isinstance(k, str) and isinstance(v, str):
                            MentionAllPlugin._masked[k] = v
        except Exception as exc:
            self.log("masked map load failed: %s" % exc)
        return bool(MentionAllPlugin._masked)

    def _remember_mask(self, peer: int, expanded_text: str, original_text: str):
        cid = chat_id_from_dialog(int(peer))
        if cid is None or not expanded_text or not original_text:
            return
        self._ensure_masked_loaded()
        key = mask_key(cid, expanded_text)
        MentionAllPlugin._masked.pop(key, None)
        MentionAllPlugin._masked[key] = original_text
        while len(MentionAllPlugin._masked) > _MASK_LIMIT:
            oldest = next(iter(MentionAllPlugin._masked))
            MentionAllPlugin._masked.pop(oldest, None)
        try:
            if hasattr(self, "set_setting"):
                self.set_setting(_MASK_KEY, json.dumps(
                    MentionAllPlugin._masked, ensure_ascii=False))
        except Exception as exc:
            self.log("masked map save failed: %s" % exc)

    def _lookup_mask(self, msg) -> Optional[str]:
        if not self._ensure_masked_loaded() or not self.get_setting("enabled", True):
            return None
        try:
            owner = getattr(msg, "messageOwner", None)
            if owner is None or not bool(getattr(owner, "out", False)):
                return None
            raw = getattr(owner, "message", None)
            if not raw:
                return None
            cid = chat_id_from_dialog(int(msg.getDialogId()))
            if cid is None:
                return None
            return MentionAllPlugin._masked.get(mask_key(cid, str(raw)))
        except Exception:
            return None

    def _mask_stack(self, attr: str) -> list:
        local = self.__dict__.get("_local")
        if local is None:
            local = threading.local()
            self.__dict__["_local"] = local
        stack = getattr(local, attr, None)
        if stack is None:
            stack = []
            setattr(local, attr, stack)
        return stack

    def _after_message_set_type(self, param):
        msg = param.thisObject
        original = self._lookup_mask(msg)
        if original is None:
            return
        try:
            if str(getattr(msg, "messageText", "") or "") != original:
                msg.messageText = original
        except Exception as exc:
            self.log("mask setType failed: %s" % exc)

    def _before_message_layout(self, param):
        msg = param.thisObject
        original = self._lookup_mask(msg)
        if original is None:
            return
        try:
            from java.util import ArrayList
            owner = msg.messageOwner
            if str(getattr(msg, "messageText", "") or "") != original:
                msg.messageText = original
            self._mask_stack("layout_stack").append((msg, owner, owner.entities))
            owner.entities = ArrayList()
        except Exception as exc:
            self.log("mask layout before failed: %s" % exc)

    def _after_message_layout(self, param):
        stack = self._mask_stack("layout_stack")
        if not stack or stack[-1][0] is not param.thisObject:
            return
        _, owner, entities = stack.pop()
        try:
            owner.entities = entities
        except Exception as exc:
            self.log("mask layout after failed: %s" % exc)

    def _before_message_caption(self, param):
        msg = param.thisObject
        original = self._lookup_mask(msg)
        if original is None:
            return
        try:
            from java.util import ArrayList
            owner = msg.messageOwner
            self._mask_stack("caption_stack").append(
                (msg, owner, owner.message, owner.entities))
            owner.message = original
            owner.entities = ArrayList()
        except Exception as exc:
            self.log("mask caption before failed: %s" % exc)

    def _after_message_caption(self, param):
        stack = self._mask_stack("caption_stack")
        if not stack or stack[-1][0] is not param.thisObject:
            return
        _, owner, message, entities = stack.pop()
        try:
            owner.message = message
            owner.entities = entities
        except Exception as exc:
            self.log("mask caption after failed: %s" % exc)

    def _before_dialog_preview(self, param):
        try:
            msg = param.thisObject.getMessage()
        except Exception:
            return
        original = self._lookup_mask(msg)
        if original is None:
            return
        try:
            from java.util import ArrayList
            owner = msg.messageOwner
            self._mask_stack("dialog_stack").append(
                (param.thisObject, owner, owner.message, owner.entities))
            owner.message = original
            owner.entities = ArrayList()
        except Exception as exc:
            self.log("mask dialog preview before failed: %s" % exc)

    def _after_dialog_preview(self, param):
        stack = self._mask_stack("dialog_stack")
        if not stack or stack[-1][0] is not param.thisObject:
            return
        _, owner, message, entities = stack.pop()
        try:
            owner.message = message
            owner.entities = entities
        except Exception as exc:
            self.log("mask dialog preview after failed: %s" % exc)

    # ---- settings and self-test ----

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Mention All"),
            Switch(key="enabled",
                   text=self._text("Enable", "Включить"),
                   default=True),
            Input(key="limit",
                  text=self._text("Mention limit", "Максимум упоминаний"),
                  default="100",
                  subtext=self._text(
                      "Maximum mentions per message",
                      "Ограничение на размер одного сообщения")),
            Text(text=self._text("Self-test", "Самопроверка"),
                 subtext=self._text(
                     "Check Telegram classes and plugin permissions",
                     "Проверяет классы Telegram и разрешения плагина"),
                 on_click=self._self_test),
        ]

    def _self_test(self):
        report = self._check_report()
        self.log("self-test: " + report)
        self._alert(
            self._text("Mention All: self-test", "Mention All: проверка"),
            report)

    def _check_report(self) -> str:
        ok = self._text("ok", "ок")
        tg_label = self._text("Telegram classes", "классы Telegram")
        checks = []
        try:
            from org.telegram.tgnet import TLRPC  # noqa: F401
            checks.append("%s: %s" % (tg_label, ok))
        except Exception as exc:
            checks.append("%s: %s" % (tg_label, exc))
        for perm in ("messages.send", "network", "hooks"):
            try:
                from client_utils import _require
                _require(perm, "self-test")
                checks.append("%s: %s" % (perm, ok))
            except Exception as exc:
                checks.append("%s: %s" % (perm, exc))
        return "\n".join(checks)

    def _limit(self) -> int:
        try:
            return max(0, int(self.get_setting("limit", "100")))
        except (TypeError, ValueError):
            return 100

    # ---- outgoing message hook ----

    def _cached_members(self, account: int, peer: int):
        hit = self._members.get((account, peer))
        if hit is None:
            return None
        stamp, members, input_users = hit
        if time.monotonic() - stamp > _MEMBERS_TTL:
            self._members.pop((account, peer), None)
            return None
        return members, input_users

    def _entities(self, spans, input_users):
        """Build outgoing entities: TL_inputMessageEntityMentionName + InputUser
        for members without a username, TL_messageEntityMention for @username."""
        from java.util import ArrayList
        from org.telegram.tgnet import TLRPC

        entities = ArrayList()
        for offset, length, uid, uname in spans:
            if uname:
                entity = TLRPC.TL_messageEntityMention()
            else:
                entity = TLRPC.TL_inputMessageEntityMentionName()
                input_user = input_users.get(int(uid))
                if input_user is None or isinstance(
                        input_user, TLRPC.TL_inputUserEmpty):
                    raise ValueError("no InputUser for id %d" % int(uid))
                entity.user_id = input_user
            entity.offset = int(offset)
            entity.length = int(length)
            entities.add(entity)
        return entities

    def on_send_message_hook(self, account: int, params: Any):
        if not self.get_setting("enabled", True):
            return None
        # shortcut: text and captions in groups only; captionless media is untouched
        field = "message" if params.message else "caption" if params.caption else None
        if field is None or int(params.peer) >= 0:
            return None
        text = str(getattr(params, field))
        if not TOKEN_RE.search(text):
            return None
        key = (int(params.peer), text)
        ts = self._recent_fail.get(key)
        if ts is not None and time.monotonic() - ts < _FAIL_TTL:
            return None

        cached = self._cached_members(account, int(params.peer))
        if cached is None:
            self._mention_all(account, params, field, text)
            return HookResult(strategy=HookStrategy.CANCEL)

        members, input_users = cached
        return self._apply(account, params, field, text, members, input_users)

    def _apply(self, account: int, params: Any, field: str, text: str,
               members, input_users):
        """Mutate params in place and return MODIFY so entities travel in the
        standard client sendMessage path."""
        try:
            unnamed = self._text("Unnamed", "Без имени")
            new_text, spans = build_mentions(text, members, self._limit(), unnamed)
            if not spans or not new_text.strip():
                return None
            entities = self._entities(spans, input_users)
        except Exception as exc:
            self._journal_tell("entity_build %s" % (exc,))
            return None
        self._remember_mask(int(params.peer), new_text, text)
        setattr(params, field, new_text)
        if entities.size() > 0:
            params.entities = entities
        self.log("mention-all: %d mentions, message length %d"
                 % (len(spans), utf16len(new_text)))
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    # ---- member fetching ----

    def _mention_all(self, account: int, params: Any, field: str, text: str):
        from client_utils import get_messages_controller, send_request
        from org.telegram.tgnet import TLRPC

        try:
            peer = int(params.peer)
            chat_id = chat_id_from_dialog(peer)
            chat = get_messages_controller(account).getChat(chat_id) if chat_id else None
            if chat is None:
                self._fail(
                    account, params,
                    self._text("chat not found (peer=%s, chat_id=%s)",
                               "чат не найден (peer=%s, chat_id=%s)") % (peer, chat_id),
                    field, text, tag="chat_not_found")
                return

            def done(users, error):
                self._finish(account, params, field, text, users, error)

            if chat.megagroup or chat.gigagroup:
                self._supergroup_members(account, chat_id, chat.access_hash,
                                         self._limit(), done)
            else:
                req = TLRPC.TL_messages_getFullChat()
                req.chat_id = int(chat_id)

                def full_done(response, error):
                    try:
                        users = []
                        if error is None and response is not None:
                            users = self._response_users(account, response.users)
                        empty = self._text("member list is empty",
                                           "список участников пуст")
                        done(users, error if error is not None
                             else None if users else empty)
                    except Exception as exc:
                        done(None, "getFullChat: %r" % (exc,))

                send_request(req, full_done, account=account)
        except Exception as exc:
            self._fail(
                account, params,
                self._text("startup error: %r", "ошибка запуска: %r") % (exc,),
                field, text, tag="start")

    def _response_users(self, account: int, response_users):
        """Read members from response.users and enrich usernames from cache.

        Skip id == 0: MessagesController.getUser(0) returns the current user.
        """
        from client_utils import get_messages_controller

        try:
            mc = get_messages_controller(account)
        except Exception:
            mc = None
        users = []
        for user in _jlist(response_users):
            try:
                uid = int(user.id)
            except Exception:
                continue
            if uid == 0:
                continue
            cached = None
            if mc is not None:
                try:
                    cached = mc.getUser(uid)
                except Exception:
                    cached = None
            if cached is not None and int(cached.id) == uid:
                users.append(cached)
            else:
                users.append(user)
        return users

    def _supergroup_members(self, account: int, chat_id: int, access_hash: int,
                            limit: int, on_done, offset: int = 0,
                            collected: Optional[list] = None):
        from client_utils import send_request
        from org.telegram.tgnet import TLRPC

        if collected is None:
            collected = []
        batch = min(200, limit - len(collected))
        if batch <= 0:
            on_done(collected, None)
            return
        req = TLRPC.TL_channels_getParticipants()
        req.channel = TLRPC.TL_inputChannel()
        req.channel.channel_id = int(chat_id)
        req.channel.access_hash = access_hash
        req.filter = TLRPC.TL_channelParticipantsRecent()
        req.offset = int(offset)
        req.limit = int(batch)

        def page_done(response, error):
            try:
                if error is not None or response is None:
                    empty = self._text("empty response", "пустой ответ")
                    on_done(collected, "getParticipants: %s"
                            % (_error_text(error) or empty))
                    return
                users = self._response_users(account, response.users)
                collected.extend(users)
                got = len(_jlist(response.participants))
                if got < batch or len(collected) >= limit:
                    on_done(collected, None)
                else:
                    self._supergroup_members(account, chat_id, access_hash,
                                             limit, on_done, offset + got,
                                             collected)
            except Exception as exc:
                on_done(collected, "getParticipants: %r" % (exc,))

        try:
            send_request(req, page_done, account=account)
        except Exception as exc:
            on_done(collected, "getParticipants: %r" % (exc,))

    # ---- assembly and resend ----

    def _finish(self, account: int, params: Any, field: str, text: str,
                users, error):
        if error is not None or not users:
            empty = self._text("empty", "пусто")
            self._fail(
                account, params,
                self._text("could not fetch member list (%s)",
                           "не получить список участников (%s)")
                % (_error_text(error) or empty),
                field, text, tag="members_request")
            return

        from client_utils import get_messages_controller, get_user_config

        try:
            me = int(get_user_config(account).getClientUserId())
            mc = get_messages_controller(account)
            entries = []
            input_users = {}
            for user in users:
                uid = int(user.id)
                uname = (user.username or "").strip()
                name = (user.first_name or "") + \
                    ((" " + user.last_name) if user.last_name else "")
                if not uname:
                    input_users[uid] = mc.getInputUser(user)
                entries.append((uid, uname, name,
                                bool(user.bot or user.deleted)))
            members, _ = pick_members(entries, me)

            limit = self._limit()
            unnamed = self._text("Unnamed", "Без имени")
            new_text, spans = build_mentions(text, members, limit, unnamed)
            if not spans or not new_text.strip():
                self._fail(
                    account, params,
                    self._text(
                        "no one to mention: fetched %d, selected %d, limit %d",
                        "некого упоминать: получено %d, отобрано %d, лимит %d")
                    % (len(users), len(members), limit),
                    field, text, tag="no_members")
                return
            self._members[(account, int(params.peer))] = (
                time.monotonic(), members, input_users)
            self._resend(account, params)
        except Exception as exc:
            self._fail(
                account, params,
                self._text("mention build failed: %r",
                           "сборка упоминаний: %r") % (exc,),
                field, text, tag="build")

    def _fail(self, account: int, params: Any, reason: str,
              field: Optional[str] = None, text: Optional[str] = None,
              tag: str = "fail"):
        self.log("mention-all FAIL: " + reason)
        self._journal_tell("%s %s" % (tag, reason))
        self._alert("Mention All", reason + "\n\n" + self._check_report())
        if field is not None and text is not None:
            self._recent_fail[(int(params.peer), text)] = time.monotonic()
        self._resend(account, params, field, text)

    def _journal_tell(self, text: str):
        """Record an ASCII failure tag in the plugin activity journal.
        shortcut: relies on the import-audit log; drop once error reporting API exists."""
        safe = re.sub(r"[^0-9A-Za-z]+", "_", str(text)).strip("_")[:120]
        if not safe:
            return
        try:
            __import__("mention_all_error_%s" % safe)
        except Exception:
            pass

    def _resend(self, account: int, params: Any, field: Optional[str] = None,
                text: Optional[str] = None, entities: Any = None):
        from android_utils import run_on_ui_thread
        from client_utils import get_send_messages_helper

        helper = get_send_messages_helper(account)

        def go():
            if field is not None and text is not None:
                setattr(params, field, fallback_text(text))
                if entities is not None and entities.size() > 0:
                    params.entities = entities
            if field == "message" and not (params.message or "").strip():
                return
            helper.sendMessage(params)

        run_on_ui_thread(go)

    def _alert(self, title: str, message: str):
        try:
            from ui.alert import AlertDialogBuilder
            builder = AlertDialogBuilder()
            builder.set_title(title)
            builder.set_message(message)
            builder.set_positive_button(self._text("OK", "Ок"))
            builder.show()
        except Exception as exc:
            self.log("alert failed (%r): %s" % (exc, message))
