# Mention All — плагин exteraless / exteraGram
#
# Заменяет @all в вашем сообщении на упоминания всех участников группы
# (text_mention: пингуется каждый, даже без юзернейма).
#
# Разрешения: messages.send (хук исходящих + повторная отправка),
# network (TL-запрос списка участников).
#
# Любой сбой показывается бюллетенем с именем шага — иначе молчаливый
# отказ не отличить от «плагин не работает».

__id__ = "mention_all"
__name__ = "Mention All"
__description__ = "Пишете @all в группе — плагин отмечает всех её участников"
__author__ = "@vxrn0"
__version__ = "1.2.3"
__category__ = "chats"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.3"
__permissions__ = ["messages.send", "network"]

import re
import time
import unicodedata
from typing import Any, List, Optional, Tuple

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Input, Switch, Text

# @all отдельным словом, не внутри @username и не @@all
TOKEN_RE = re.compile(r"(?<![\w@])@all(?!\w)", re.IGNORECASE)
# уборка повторных токенов: съедает и пробел перед ними, чтобы не плодить дыры
TOKEN_CLEAN = re.compile(r"\s?(?<![\w@])@all(?!\w)", re.IGNORECASE)

SUPERGROUP_FLAG = -1000000000000

# сколько секунд после сбоя не пытаться снова на том же тексте
_FAIL_TTL = 60.0
# сколько секунд держать список участников чата
_MEMBERS_TTL = 600.0


def is_invisible(ch: str) -> bool:
    """Символ, который не видно: вариационные селекторы, форматирующие,
    управляющие. В Telegram имя профиля можно поставить целиком из таких —
    тогда упоминание выглядит пустым (1.2.1 на устройстве: U+FE0E)."""
    if "\ufe00" <= ch <= "\ufe0f" or "\U000e0100" <= ch <= "\U000e01ef":
        return True
    return unicodedata.category(ch) in ("Cf", "Cc", "Cs", "Co")


def clean_label(name: str) -> str:
    """Имя без невидимых символов, с схлопнутыми пробелами.
    Комбинирующие знаки (Mn) не трогаем — они нужны живым письменностям."""
    kept = []
    for ch in name or "":
        if is_invisible(ch):
            continue
        kept.append(" " if ch.isspace() else ch)
    return " ".join("".join(kept).split())


def utf16len(s: str) -> int:
    # Telegram считает offsets в кодовых единицах UTF-16
    return len(s.encode("utf-16-le")) // 2


def chat_id_from_dialog(dialog_id: int) -> Optional[int]:
    """dialog_id -> id чата; None для личок и каналов-без-переписки."""
    if SUPERGROUP_FLAG < dialog_id < 0:
        return -dialog_id  # базовая группа
    if dialog_id <= SUPERGROUP_FLAG:
        return -dialog_id + SUPERGROUP_FLAG  # супергруппа
    return None


def build_mentions(text: str, members: List[Tuple[int, Optional[str], str]],
                   limit: int) -> Tuple[str, List[Tuple[int, int, int, Optional[str]]]]:
    """Заменить первый @all на упоминания участников, остальные токены убрать.

    members: [(user_id, username|None, имя)]. Участник с юзернеймом пишется
    как @username (сервер распознаёт упоминание сам), без юзернейма — именем
    (для него вызывающий строит text_mention).

    Возвращает (новый_текст, [(offset_utf16, length_utf16, user_id,
    username|None), ...]).
    """
    match = TOKEN_RE.search(text)
    if match is None or not members:
        return text, []
    # имя может содержать @all — вырезаем, иначе повторный хук зациклит отправку
    picked = [(uid, (uname or "").strip(),
               clean_label(TOKEN_CLEAN.sub("", name)))
              for uid, uname, name in members[:max(0, limit)]]
    pieces = []
    spans = []
    pos = utf16len(text[:match.start()])
    placeholder = 0
    for uid, uname, name in picked:
        if uname:
            span = "@" + uname
        else:
            # имя может быть невидимым (профиль без видимых символов):
            # text_mention нужен видимый текст, иначе выходят пробелы
            span = name
            if not span:
                placeholder += 1
                span = "Участник %d" % placeholder
        pieces.append(span)
        spans.append((pos, utf16len(span), uid, uname or None))
        pos += utf16len(span) + 1  # разделительный пробел
    new_text = text[:match.start()] + " ".join(pieces) \
        + TOKEN_CLEAN.sub("", text[match.end():])
    return new_text, spans


def pick_members(entries: List[Tuple[int, str, str, bool]], me: int):
    """Отобрать, кого упоминать.

    entries: [(user_id, username, имя, бот_или_удалён)]. Сначала живые люди,
    иначе боты/удалённые, иначе все. Третий вариант — страховка: сравнение
    id с собой в клиенте врёт и однажды съело весь список (1.1.3).

    Возвращает ([(user_id, username, имя), ...], фильтр_себя_съел_всё).
    """
    people = [e for e in entries if e[0] != me and not e[3]]
    others = [e for e in entries if e[0] != me and e[3]]
    chosen = people or others
    if chosen:
        return [(uid, uname, name) for uid, uname, name, _ in chosen], False
    return [(uid, uname, name) for uid, uname, name, _ in entries], True


def fallback_text(text: str) -> str:
    """Текст для отправки после сбоя: без токена @all, но никогда не пустой —
    пустой пузырь хуже, чем сообщение с токеном (баг 1.1.4)."""
    stripped = TOKEN_CLEAN.sub("", text).strip()
    return stripped or text


def _error_text(error) -> str:
    """TL_error или исключение — читаемая строка."""
    if error is None:
        return ""
    return str(getattr(error, "text", None) or error)


def _jlist(java_list) -> list:
    """Java-список в питоновский: итерация по прокси не работает
    (TypeError 'ArrayList' object is not iterable), индексы — работают."""
    out = []
    if java_list is None:
        return out
    for i in range(java_list.size()):
        out.append(java_list.get(i))
    return out


class MentionAllPlugin(BasePlugin):
    # (peer, текст) -> время сбоя; класс, а не экземпляр: защёлка должна
    # переживать перезагрузку плагина в живом процессе
    _recent_fail = {}
    # (account, peer) -> (время сбора, участники, InputUser по id):
    # хук синхронный, а участники приходят из сети — без кэша entities
    # не собрать в том же вызове, в котором клиент читает params
    _members = {}
    # одна диагностическая строка в журнал за запуск процесса
    _diag_done = False
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.log("mention-all loaded, hook registered")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Mention All"),
            Switch(key="enabled", text="Включить", default=True),
            Input(key="limit", text="Максимум упоминаний", default="100",
                  subtext="Ограничение на размер одного сообщения"),
            Text(text="Самопроверка",
                 subtext="Проверяет классы Telegram и разрешения плагина",
                 on_click=self._self_test),
        ]

    def _self_test(self):
        """Диагностика в один клик: называет сломанный шаг."""
        report = self._check_report()
        self.log("self-test: " + report)
        self._alert("Mention All: проверка", report)

    def _check_report(self) -> str:
        checks = []
        try:
            from org.telegram.tgnet import TLRPC  # noqa: F401
            checks.append("классы Telegram: ок")
        except Exception as exc:
            checks.append("классы Telegram: %s" % (exc,))
        try:
            from client_utils import _require
            _require("messages.send", "self-test")
            checks.append("messages.send: ок")
        except Exception as exc:
            checks.append("messages.send: %s" % (exc,))
        try:
            from client_utils import _require
            _require("network", "self-test")
            checks.append("network: ок")
        except Exception as exc:
            checks.append("network: %s" % (exc,))
        return "\n".join(checks)

    def _limit(self) -> int:
        try:
            return max(0, int(self.get_setting("limit", "100")))
        except (TypeError, ValueError):
            return 100

    # ---- хук исходящих ----

    def _cached_members(self, account: int, peer: int):
        """Участники из кэша (свежие — не старше TTL), иначе None."""
        hit = self._members.get((account, peer))
        if hit is None:
            return None
        stamp, members, input_users = hit
        if time.monotonic() - stamp > _MEMBERS_TTL:
            self._members.pop((account, peer), None)
            return None
        return members, input_users

    def _entities(self, spans, input_users):
        """Строит именно input-entities для исходящего запроса.

        TL_inputMessageEntityMentionName + InputUser — тип, который использует
        сам клиент при выборе человека без username из @-меню.
        TL_messageEntityMentionName — серверная entity для уже отправленного
        сообщения; для исходящего запроса она неверна.
        """
        from java.util import ArrayList
        from org.telegram.tgnet import TLRPC

        entities = ArrayList()
        for offset, length, uid, uname in spans:
            if uname:
                entity = TLRPC.TL_messageEntityMention()
            else:
                entity = TLRPC.TL_inputMessageEntityMentionName()
                input_user = input_users.get(int(uid))
                if input_user is None or isinstance(
                        input_user, TLRPC.TL_inputUserEmpty):
                    raise ValueError("no InputUser for id %d" % int(uid))
                entity.user_id = input_user
            entity.offset = int(offset)
            entity.length = int(length)
            entities.add(entity)
        return entities

    def on_send_message_hook(self, account: int, params: Any):
        if not self.get_setting("enabled", True):
            return None
        # shortcut: только текст и подписи, только группы; медиа без подписи мимо
        field = "message" if params.message else "caption" if params.caption else None
        if field is None or int(params.peer) >= 0:
            return None
        text = str(getattr(params, field))
        if not TOKEN_RE.search(text):
            return None
        # уже падали на этом тексте — отправляем как напечатано, без цикла
        key = (int(params.peer), text)
        ts = self._recent_fail.get(key)
        if ts is not None and time.monotonic() - ts < _FAIL_TTL:
            return None

        cached = self._cached_members(account, int(params.peer))
        if cached is None:
            # Список участников приходит из сети: отменяем отправку, собираем
            # и переотправляем. Переотправка снова проходит этот хук — уже с
            # тёплым кэшем, то есть ниже, штатным MODIFY.
            self._mention_all(account, params, field, text)
            return HookResult(strategy=HookStrategy.CANCEL)

        members, input_users = cached
        return self._apply(account, params, field, text, members, input_users)

    def _apply(self, account: int, params: Any, field: str, text: str,
               members, input_users):
        """Один проход: подменить текст и entities прямо в params и вернуть
        MODIFY. Java читает entities из params уже после хука, поэтому это
        штатный путь клиента — без переотправки и без позиционных overload'ов."""
        try:
            new_text, spans = build_mentions(text, members, self._limit())
            if not spans or not new_text.strip():
                return None
            entities = self._entities(spans, input_users)
        except Exception as exc:
            self._journal_tell("entity_build %s" % (exc,))
            return None
        setattr(params, field, new_text)
        if entities.size() > 0:
            params.entities = entities
        self.log("mention-all: %d mentions, message length %d"
                 % (len(spans), utf16len(new_text)))
        # inv — сколько в итоговом тексте невидимых символов: если не ноль,
        # значит в имя всё ещё пролезло что-то невидимое
        input_count = sum(1 for _, _, _, uname in spans if not uname)
        self._journal_tell("modify n %d e %d input %d len %d inv %d"
                           % (len(spans), entities.size(), input_count,
                              utf16len(new_text),
                              sum(1 for ch in new_text if is_invisible(ch))))
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    # ---- сбор участников ----

    def _mention_all(self, account: int, params: Any, field: str, text: str):
        from client_utils import get_messages_controller, send_request
        from org.telegram.tgnet import TLRPC

        try:
            peer = int(params.peer)
            chat_id = chat_id_from_dialog(peer)
            chat = get_messages_controller(account).getChat(chat_id) if chat_id else None
            if chat is None:
                self._fail(account, params,
                           "чат не найден (peer=%s, chat_id=%s)" % (peer, chat_id),
                           field, text, tag="chat_not_found")
                return
            self.log("mention-all: peer=%s chat_id=%s supergroup=%s"
                     % (peer, chat_id, bool(chat.megagroup or chat.gigagroup)))

            def done(users, error):
                self._finish(account, params, field, text, users, error)

            if chat.megagroup or chat.gigagroup:
                self._supergroup_members(account, chat_id, chat.access_hash,
                                         self._limit(), done)
            else:
                req = TLRPC.TL_messages_getFullChat()
                req.chat_id = int(chat_id)

                def full_done(response, error):
                    try:
                        users = []
                        if error is None and response is not None:
                            users = self._response_users(account, response.users)
                        done(users, error if error is not None
                             else None if users else "список участников пуст")
                    except Exception as exc:
                        done(None, "getFullChat: %r" % (exc,))

                send_request(req, full_done, account=account)
        except Exception as exc:
            self._fail(account, params, "ошибка запуска: %r" % (exc,), field, text,
                       tag="start")

    def _response_users(self, account: int, response_users):
        """Участники из поля users ответа, с уточнением юзернеймов из кэша.

        В этом слое ChannelParticipant больше не имеет user_id (id лежит в
        peer), поэтому participants не годятся: participant.user_id = 0, а
        MessagesController.getUser(0) отдаёт ТЕКУЩЕГО пользователя, не None.
        На устройстве (1.2.0) это дало пять «вас» и текст из пробелов.
        Поэтому источник — response.users; кэш только уточняет юзернейм и
        принимается лишь при совпадении id.
        """
        from client_utils import get_messages_controller

        try:
            mc = get_messages_controller(account)
        except Exception:
            mc = None
        users = []
        for user in _jlist(response_users):
            try:
                uid = int(user.id)
            except Exception:
                continue
            if uid == 0:
                continue  # пустышка, кэш по нулю вернёт текущего пользователя
            cached = None
            if mc is not None:
                try:
                    cached = mc.getUser(uid)
                except Exception:
                    cached = None
            if cached is not None and int(cached.id) == uid:
                users.append(cached)
            else:
                users.append(user)
        return users

    def _supergroup_members(self, account: int, chat_id: int, access_hash: int,
                            limit: int, on_done, offset: int = 0,
                            collected: Optional[list] = None):
        from client_utils import send_request
        from org.telegram.tgnet import TLRPC

        if collected is None:
            collected = []
        batch = min(200, limit - len(collected))
        if batch <= 0:
            on_done(collected, None)
            return
        req = TLRPC.TL_channels_getParticipants()
        # поле channel ждёт InputChannel; TL_inputPeerChannel — это InputPeer
        # и не конвертируется (ошибка 1.0.3 на устройстве)
        req.channel = TLRPC.TL_inputChannel()
        req.channel.channel_id = int(chat_id)
        req.channel.access_hash = access_hash
        req.filter = TLRPC.TL_channelParticipantsRecent()
        req.offset = int(offset)
        req.limit = int(batch)

        def page_done(response, error):
            try:
                if error is not None or response is None:
                    on_done(collected, "getParticipants: %s"
                            % (_error_text(error) or "пустой ответ"))
                    return
                # participants не используем: у ChannelParticipant в этом слое
                # нет user_id (только peer) — см. _response_users
                users = self._response_users(account, response.users)
                collected.extend(users)
                got = len(_jlist(response.participants))
                if got < batch or len(collected) >= limit:
                    on_done(collected, None)
                else:
                    self._supergroup_members(account, chat_id, access_hash,
                                             limit, on_done, offset + got,
                                             collected)
            except Exception as exc:
                on_done(collected, "getParticipants: %r" % (exc,))

        try:
            send_request(req, page_done, account=account)
        except Exception as exc:
            on_done(collected, "getParticipants: %r" % (exc,))

    # ---- сборка и повторная отправка ----

    def _finish(self, account: int, params: Any, field: str, text: str,
                users, error):
        if error is not None or not users:
            self._fail(account, params, "не получить список участников (%s)"
                       % (_error_text(error) or "пусто"), field, text,
                       tag="members_request")
            return

        from client_utils import get_messages_controller, get_user_config

        try:
            me = int(get_user_config(account).getClientUserId())
            mc = get_messages_controller(account)
            entries = []
            input_users = {}
            for user in users:
                uid = int(user.id)
                uname = (user.username or "").strip()
                name = clean_label((user.first_name or "") +
                                   ((" " + user.last_name)
                                    if user.last_name else ""))
                if not uname:
                    input_users[uid] = mc.getInputUser(user)
                # пустое имя не повод выкидывать человека: в build_mentions
                # он получит видимую подпись «Участник N» и всё равно пинг
                entries.append((uid, uname, name,
                                bool(user.bot or user.deleted)))
            members, self_filter_ate_all = pick_members(entries, me)
            if not MentionAllPlugin._diag_done:
                MentionAllPlugin._diag_done = True
                # одна строка правды о том, что реально пришло с устройства
                self._journal_tell(
                    "diag me %d n %d ids %s" % (
                        me, len(entries),
                        " ".join("%d:%d" % (e[0], 1 if e[1] else 0)
                                 for e in entries[:4])))
            if self_filter_ate_all:
                # сравнение id в этом клиенте врёт и «это я» съедает весь
                # список (1.1.3 на устройстве: получено 5, осталось 0).
                # Упомянуть себя безобиднее, чем не упомянуть никого.
                self._journal_tell(
                    "self_filter_all me %d ids %s"
                    % (me, " ".join(str(e[0]) for e in entries[:3])))

            limit = self._limit()
            new_text, spans = build_mentions(text, members, limit)
            if not spans or not new_text.strip():
                self._fail(account, params,
                           "некого упоминать: получено %d, отобрано %d, "
                           "лимит %d" % (len(users), len(members), limit),
                           field, text, tag="no_members")
                return
            self._members[(account, int(params.peer))] = (
                time.monotonic(), members, input_users)
            self.log("mention-all: %d mentions, message length %d"
                     % (len(spans), utf16len(new_text)))
            # Переотправка снова проходит хук — кэш тёплый, и там сработает
            # MODIFY: текст и entities уйдут одним штатным вызовом клиента
            self._resend(account, params)
        except Exception as exc:
            self._fail(account, params, "сборка упоминаний: %r" % (exc,),
                       field, text, tag="build")

    def _fail(self, account: int, params: Any, reason: str,
              field: Optional[str] = None, text: Optional[str] = None,
              tag: str = "fail"):
        """Сбой: показать причину один раз и отправить без повторного входа."""
        self.log("mention-all FAIL: " + reason)
        # tag — латиницей: кириллицу журнал не примет (см. _journal_tell)
        self._journal_tell("%s %s" % (tag, reason))
        # диалог, а не бюллетень: остаётся на экране, пока пользователь не
        # закроет — текст ошибки теперь реально можно прочитать
        self._alert("Mention All", reason + "\n\n" + self._check_report())
        if field is not None and text is not None:
            # защёлка + вырезанный триггер: повторный хук не должен снова
            # уйти в тот же сбой (1.0.1 циклил тут бесконечными бюллетенями)
            self._recent_fail[(int(params.peer), text)] = time.monotonic()
        self._resend(account, params, field, text)  # не теряем сообщение

    def _journal_tell(self, text: str):
        """Причину сбоя — в журнал активности: его стабильно смотрят и
        скринят, в отличие от диалога. Кириллица в имени модуля недопустима,
        поэтому в журнал попадает только латинская часть — ASCII-тег из
        _fail и числа; русский текст причины остаётся в диалоге.
        shortcut: хак через импорт-событие audit-гейта, убрать, когда ошибки уйдут."""
        safe = re.sub(r"[^0-9A-Za-z]+", "_", str(text)).strip("_")[:120]
        if not safe:
            return
        try:
            __import__("mention_all_error_%s" % safe)
        except Exception:
            pass  # ImportError и есть: событие в журнал пишется до резолва

    def _resend(self, account: int, params: Any, field: Optional[str] = None,
                text: Optional[str] = None, entities: Any = None):
        """Переотправка тем же публичным sendMessage(params), каким ходит
        клиент. Вызов снова проходит хук: если кэш участников тёплый, там
        сработает MODIFY и entities уйдут штатно; если нет — текст уйдёт
        хотя бы без упоминаний, но никогда пустым."""
        from android_utils import run_on_ui_thread
        from client_utils import get_send_messages_helper

        helper = get_send_messages_helper(account)

        def go():
            if field is not None and text is not None:
                setattr(params, field, fallback_text(text))
                if entities is not None and entities.size() > 0:
                    params.entities = entities
            if field == "message" and not (params.message or "").strip():
                self._journal_tell("skip_empty_message")
                return
            helper.sendMessage(params)
            self._journal_tell("resent len %d" % len(
                str(getattr(params, field or "message") or "")))

        run_on_ui_thread(go)

    def _alert(self, title: str, message: str):
        """Диалог: не исчезает сам, текст можно прочитать и снять скриншот."""
        try:
            from ui.alert import AlertDialogBuilder
            builder = AlertDialogBuilder()
            builder.set_title(title)
            builder.set_message(message)
            builder.set_positive_button("Ок")
            builder.show()
        except Exception as exc:
            self.log("alert failed (%r): %s" % (exc, message))
